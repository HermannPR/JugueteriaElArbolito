# Copiar a .env.local para desarrollo; en producción van en Vercel → Settings → Environment Variables.

# --- Públicas (llegan al navegador) ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Solo servidor (NUNCA con prefijo NEXT_PUBLIC_) ---
# Supabase → Project Settings → API → service_role. Ignora RLS: solo la usan checkout, webhook y cron.
SUPABASE_SERVICE_ROLE_KEY=

# Mercado Pago → Tus integraciones → Credenciales. Vacío = modo simulación (solo en desarrollo).
MERCADOPAGO_ACCESS_TOKEN=
# Mercado Pago → Tus integraciones → Webhooks → "Clave secreta". Sin ella el webhook responde 503.
MERCADOPAGO_WEBHOOK_SECRET=

# Vercel la manda en el header Authorization al llamar /api/cron/keepalive. Cualquier cadena larga aleatoria.
CRON_SECRET=

# Chatbot (opcionales; sin llaves responde con el mensaje fijo)
OPENROUTER_API_KEY=
# Varios modelos separados por coma = respaldo automático si uno está saturado
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free,google/gemma-4-31b-it:free,qwen/qwen3.8-27b:free
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
