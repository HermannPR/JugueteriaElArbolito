# Supabase → Project Settings → API. La service_role key vive SOLO en esta PC.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=

# Conexión a Eleventa por su servidor Firebird (host:ruta). Confirmar la ruta real en la PC.
FDB_DSN=localhost:C:\Program Files (x86)\AbarrotesPDV\db\PDVDATA.FDB
FDB_USER=SYSDBA
FDB_PASSWORD=masterkey
# Solo si Python no encuentra fbclient.dll (viene con Eleventa):
FB_CLIENT_LIBRARY=

SYNC_INTERVAL_SECONDS=300
LOG_LEVEL=INFO

# --- Robustez ---
# Timeouts de Firebird (segundos): si Eleventa dejó el archivo bloqueado, la
# llamada no se cuelga; se corta y se reintenta.
FDB_CONNECT_TIMEOUT_SECONDS=15
FDB_QUERY_TIMEOUT_SECONDS=60
# Reintentos con backoff ante errores transitorios (lectura Firebird y red).
RETRY_ATTEMPTS=3
RETRY_BASE_DELAY_SECONDS=2
RETRY_MAX_DELAY_SECONDS=60

# --- Alertas ---
# Cuántos ciclos fallidos seguidos antes de avisar "caído" (evita falsas alarmas).
ALERT_FAIL_THRESHOLD=2
# Notificaciones ntfy (canal de Hivemind). SIN secretos reales aquí.
#   NTFY_URL: servidor ntfy (p. ej. https://ntfy.sh o el propio de Hivemind)
#   NTFY_TOPIC: tema/canal (p. ej. sync-arbolito)
#   NTFY_TOKEN: opcional; si el servidor requiere auth, va como Bearer <token>
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=<tu-topic-secreto>
NTFY_TOKEN=
