# Supabase → Project Settings → API. La service_role key vive SOLO en esta PC.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=

# Conexión a Eleventa por su servidor Firebird (host:ruta). Confirmar la ruta real en la PC.
