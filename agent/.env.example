FDB_USER=SYSDBA
FDB_PASSWORD=masterkey
# Solo si Python no encuentra fbclient.dll (viene con Eleventa):
FB_CLIENT_LIBRARY=

SYNC_INTERVAL_SECONDS=300
LOG_LEVEL=INFO
